  "studyroom_finalize_plan": {
    "requirements": [
      {
        "kind": "action",
        "id": "welcome_panel",
        "rule_key": "submit_room",
        "action": {
          "kind": "post_panel",
          "key": "welcome_panel",
          "channel": {
            "kind": "created",
            "name": "room_channel"
          },
          "content": "Welcome to ${input.room_name}",
          "buttons": [
            {
              "label": "Help",
              "route": {
                "kind": "static",
                "key": "study_help"
              }
            },
            {
              "label": "Close",
              "route": {
                "kind": "instance_action",
                "instance": {
                  "kind": "created",
                  "name": "study_instance"
                },
                "action": "close"
              }
            }
          ]
        },
        "minimum": 1
      },
      {
        "kind": "action",
        "id": "hub_panel",
        "rule_key": "submit_room",
        "action": {
          "kind": "post_panel",
          "key": "hub_panel",
          "channel": {
            "kind": "existing",
            "name": "study_hub"
          },
          "content": "${input.room_name} is open",
          "buttons": [
            {
              "label": "Join",
              "route": {
                "kind": "instance_action",
                "instance": {
                  "kind": "created",
                  "name": "study_instance"
                },
                "action": "join"
              }
            }
          ]
        },
        "minimum": 1
      },
      {
        "kind": "action",
        "id": "study_instance",
        "rule_key": "submit_room",
        "action": {
          "kind": "register_instance",
          "key": "study_instance",
          "instance_kind": "study_room",
          "resources": {
            "roles": [
              {
                "alias": "member_role",
                "created": "member_role"
              }
            ],
            "channels": [
              {
                "alias": "room_channel",
                "created": "room_channel"
              }
            ],
            "messages": [
              {
                "alias": "welcome_panel",
                "created": "welcome_panel"
              },
              {
                "alias": "hub_panel",
                "created": "hub_panel"
              }
            ]
          }
        },
        "minimum": 1
      },
      {
        "kind": "action",
        "id": "edit_response",
        "rule_key": "submit_room",
        "action": {
          "kind": "edit_response",
          "content": "Created ${input.room_name}"
        },
        "minimum": 1
      }
    ]
  },
